size_t oled_print_u_long(unsigned long n)
{
  uint8_t base = 10;
  if (base == 0) {
    return write(n);
  } else if (base == 10) {
    /*if (n < 0) {
      int t = oled_print_char('-');
      n = -n;
      return printNumber(n, 10) + t;
    }*/
    return printNumber(n, 10);
  } else {
    return printNumber(n, base);
  }
}

size_t oled_print_long(long n)
{
  uint8_t base = 10;
  if (base == 0) {
    return write(n);
  } else if (base == 10) {
    if (n < 0) {
      int t = oled_print_char('-');
      n = -n;
      return printNumber(n, 10) + t;
    }
    return printNumber(n, 10);
  } else {
    return printNumber(n, base);
  }
}

size_t printNumber(unsigned long n, uint8_t base)
{
  char buf[8 * sizeof(long) + 1]; // Assumes 8-bit chars plus zero byte.
  char *str = &buf[sizeof(buf) - 1];

  *str = '\0';

  // prevent crash if called with base == 1
  if (base < 2) base = 10;
  uint8_t len=0;
  do {
    char c = n % base;
    n /= base;

    *--str = c < 10 ? c + '0' : c + 'A' - 10;
    len++;
  } while (n);

  return oled_print_str(str, len);
}

size_t oled_print_float(double number, uint8_t digits) 
{ 
  size_t n = 0;
  
  if (isnan(number)) return oled_print_f(F("nan"));
  if (isinf(number)) return oled_print_f(F("inf"));
  if (number > 4294967040.0) return oled_print_f (F("ovf"));  // constant determined empirically
  if (number <-4294967040.0) return oled_print_f (F("ovf"));  // constant determined empirically
  
  // Handle negative numbers
  if (number < 0.0)
  {
     n += oled_print_char('-');
     number = -number;
  }

  // Round correctly so that print(1.999, 2) prints as "2.00"
  double rounding = 0.5;
  for (uint8_t i=0; i<digits; ++i)
    rounding /= 10.0;
  
  number += rounding;

  // Extract the integer part of the number and print it
  unsigned long int_part = (unsigned long)number;
  double remainder = number - (double)int_part;
  n += oled_print_u_long(int_part);

  // Print the decimal point, but only if there are digits beyond
  if (digits > 0) {
    n += oled_print_char('.'); 
  }

  // Extract digits from the remainder one at a time
  while (digits-- > 0)
  {
    remainder *= 10.0;
    unsigned int toPrint = (unsigned int)(remainder);
    n += oled_print_u_int(toPrint);
    remainder -= toPrint; 
  } 
  
  return n;
}
